# =============================================================
# Shyftra root .gitignore   (save as ".gitignore" in the project root,
# next to the client/ and server/ folders, BEFORE your first commit)
# =============================================================

# ---- Secrets: real env files must NEVER be committed -----------
.env
.env.*
*.env
.envrc
# ...but the empty placeholder files ARE meant to be committed:
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# ---- Dependencies ----------------------------------------------
node_modules/

# ---- Build output ----------------------------------------------
dist/
dist-ssr/
build/
.vite/

# ---- Platform / tooling folders --------------------------------
.vercel/
.render/
.cache/
.turbo/

# ---- Logs ------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Local databases (anchored: does NOT touch source folders) -
/data/
/server/data/
/dump/

# ---- Test / coverage output ------------------------------------
coverage/
.nyc_output/

# ---- Temp files ------------------------------------------------
/tmp/
/server/tmp/

# ---- OS / editor files -----------------------------------------
*.local
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?