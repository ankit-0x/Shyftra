# =============================================================
# Shyftra — client environment variables (TEMPLATE)
# =============================================================
# Copy this file to .env and fill in REAL values before running.
# NEVER commit the real .env file — it is already gitignored.
#
# On Vercel: set these in Project Settings → Environment Variables
# =============================================================

# ---- Backend API URL ----
# Set this to your deployed Render service URL (NO trailing slash, NO /api)
# Example: https://shyftra-api.onrender.com
# Leave empty for local development against http://localhost:5000
VITE_API_URL=https://shyftra-api.onrender.com

# ---- LocationIQ (map tiles) ----
# Get from: https://locationiq.com/dashboard
# This key is PUBLIC (visible in browser DevTools) — restrict it to your
# domain in the LocationIQ dashboard under "Allowed Referrers".
VITE_LOCATIONIQ_API_KEY=pk.REPLACE_WITH_LOCATIONIQ_KEY